/* 1. Force the main wrapper to be a strict flex container that NEVER wraps */
.scrolly-section {
    width: 100%;
    height: 100vh; /* Lock the view window height */
    overflow: hidden;
    position: relative;
}

/* 2. Force both columns to behave tightly inside the wrapper */
.content-wrapper {
    display: flex;
    flex-direction: row; /* Force side-by-side */
    width: 100%;
    height: 100vh;
    box-sizing: border-box;
}

/* 3. LEFT COLUMN: ANIMATION */
.animation-column {
    width: 50%; /* Exactly half width */
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
    box-sizing: border-box;
}

canvas {
    max-width: 90%; 
    max-height: 90vh;
    object-fit: contain;
}

/* 4. RIGHT COLUMN: TEXT */
.text-column {
    width: 50vh; /* Exactly half width */
    height: 100vh;
    background: #111;
    color: white;
    
    position: relative; /* Acts as the absolute anchor box */
    box-sizing: border-box; /* Forces padding to stay INSIDE the 50% width */
}

/* 5. THE TEXT CONTENT */
.text-block {
    opacity: 0;
    transform: translateY(20px);
    visibility: hidden;
    
    position: absolute; /* Stacks text inside the relative .text-column parent */
    width: 80%;       /* Keeps text from hitting the column walls */
    left: 10%;        /* Centers the block horizontally inside the column */
    top: 50%;         /* Positions the block halfway down the column */
    transform: translateY(-50%) translateY(20px); /* Centers vertically + prepares animation */
    box-sizing: border-box;
}